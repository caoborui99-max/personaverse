{
  "name": "personaverse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-server.js",
    "start": "node --env-file-if-exists=.env scripts/dev-server.js",
    "build": "node scripts/build.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --import ./tests/no-network.mjs --test tests/*.test.js",
    "check:personas": "node scripts/check-personas.mjs",
    "backup:sqlite": "node --env-file-if-exists=.env scripts/sqlite-maintenance.js backup"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {}
}
