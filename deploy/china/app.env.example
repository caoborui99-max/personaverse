# Copy to /etc/personaverse/app.env OUTSIDE the repository; chmod 600.
NODE_ENV=production
DATABASE_DRIVER=sqlite
SQLITE_PATH=/var/lib/personaverse/personaverse.sqlite
BACKUP_DIR=/var/backups/personaverse
# Replace with your verified HTTPS domain before enabling external access.
APP_ORIGIN=https://example.invalid
TRUST_PROXY=loopback
PORT=8000
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_ENABLED=false
AI_BASE_URL=https://tokenrhythm.studio/v1
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=1
AI_RATE_LIMIT=1
