# Template only: replace example.invalid and certificate paths after domain/filing checks.
# Use as an nginx http{} include. Do not activate before nginx -t succeeds.
server { listen 80 default_server; server_name _; return 444; }
server {
    listen 80;
    server_name example.invalid;
    return 301 https://example.invalid$request_uri;
}
server {
    listen 443 ssl;
    if ($host != example.invalid) { return 444; }
    server_name example.invalid;
    ssl_certificate /etc/ssl/personaverse/fullchain.pem;
    ssl_certificate_key /etc/ssl/personaverse/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    server_tokens off;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }
}
