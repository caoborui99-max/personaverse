[Unit]
Description=PersonaVerse consistent SQLite backup and restore verification
After=personaverse.service

[Service]
Type=oneshot
User=personaverse
Group=personaverse
WorkingDirectory=/opt/personaverse/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SQLITE_PATH=/var/lib/personaverse/personaverse.sqlite
Environment=BACKUP_DIR=/var/backups/personaverse
ExecStart=/usr/bin/env node scripts/sqlite-maintenance.js backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personaverse /var/backups/personaverse
