# Server environment only. Never put these values in public JS or commit .env.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local development only. Production requires DATABASE_URL.
SQLITE_PATH=.local/personaverse.sqlite
PORT=8000


# AI is OFF by default. Keep real key only in server environment.
AI_ENABLED=false
# Only this explicit mode plus a verified admin session removes personal day/month counts.
AI_QUOTA_MODE=standard
# Applied only to development administrators; 1..60 requests per UTC minute.
AI_ADMIN_RATE_LIMIT=1
# Admin-only isolation remains the default. Public sessions require a separate explicit opt-in.
AI_CHAT_ACCESS=admin
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=1
AI_RATE_LIMIT=1

# Optional lower output cap and timeout; server rejects values above these ceilings.
AI_MAX_OUTPUT_TOKENS=256
AI_TIMEOUT_MS=20000
# In admin mode, limits are fixed at 1/day globally and 1/minute per administrator.
# Only in explicit public mode: AI_DAILY_LIMIT accepts 1..100; AI_RATE_LIMIT accepts 1..3.
# Public defaults remain 1 and 1. These settings never enable AI by themselves.

# Required before ANY real Provider request. Blank means fail closed, never a free/unlimited budget.
# CNY decimal strings, up to 6 decimal places. Supply verified worst-case prices for the exact model.
AI_COST_DAILY_BUDGET_CNY=
AI_COST_MONTHLY_BUDGET_CNY=
AI_PRICE_MODEL=
AI_PRICE_BASE_URL=
AI_PRICE_INPUT_CNY_PER_MILLION=
AI_PRICE_OUTPUT_CNY_PER_MILLION=
# Set only after validating the conservative bound for the selected endpoint/model.
AI_PRICE_TOKEN_BOUND=
