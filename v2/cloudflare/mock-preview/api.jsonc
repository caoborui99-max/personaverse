{
  "name": "pv-api-mock-preview",
  "main": "api.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "@prisma/client": "../generated/client/client.ts",
    "@node-rs/argon2": "../argon-rpc.ts",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PASSWORD_HASHERS",
        "class_name": "PasswordHasher",
        "script_name": "pv-password-mock-preview",
      },
    ],
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_DEDICATED_TEST_ID" }],
  "vars": {
    "WEB_ORIGIN": "https://pv-web-mock-preview.REPLACE_ACCOUNT.workers.dev",
    "PREVIEW_DATABASE": "pv_mock_preview",
    "PREVIEW_ROLE": "pv_mock_app_preview",
    "HYPERDRIVE_CACHE_DISABLED": "false",
  },
}
