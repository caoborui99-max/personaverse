{
  "name": "pv-web-mock-preview",
  "main": "web.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PV_WORKERS_ADAPTER": "opennext",
    "MOCK_PREVIEW": "closed",
    "WEB_ORIGIN": "https://pv-web-mock-preview.REPLACE_ACCOUNT.workers.dev",
  },
  "assets": { "directory": "../../apps/web/.open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "API", "service": "pv-api-mock-preview" }],
}
