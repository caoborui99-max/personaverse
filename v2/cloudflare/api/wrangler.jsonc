{
  "name": "pv-api-local-only",
  "main": "../api-worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "@prisma/client": "../generated/client/client.ts",
