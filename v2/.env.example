# Required explicit database mode. Copy to .env.local and fill a NEW isolated local target.
# pnpm dev loads .env.local. No keys or passwords are provided by the application.
APP_ENV=development
PV_MODE=database
API_HOST=127.0.0.1
API_PORT=4311
WEB_ORIGIN=http://127.0.0.1:4310
API_INTERNAL_URL=http://127.0.0.1:4311
# Set locally, never commit the actual URL. DB name must start with personaverse_v2_dev.
DATABASE_URL=
# Tests use APP_ENV=test and database personaverse_v2_test, in generated .env.test.local.
# PV_MODE=mock-regression selects the isolated phase-2 fixture regression only.
# Production requires HTTPS + explicit DATABASE_SAFETY_CONFIRMATION, but is not deployed in this phase.
