generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminAccount {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.VarChar(254)
  passwordHash String
  status       String               @default("active")
  role         String               @default("owner")
  authVersion  Int                  @default(1)
  createdAt    DateTime             @default(now()) @db.Timestamptz
  sessions     AdminSession[]
  versions     PersonaCoreVersion[]
  chats        ChatSession[]
  audit        AdminAuditLog[]
}

model AdminSession {
  id          String       @id @default(uuid()) @db.Uuid
  adminId     String       @db.Uuid
  tokenHash   String       @unique @db.Char(64)
  authVersion Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz
  expiresAt   DateTime     @db.Timestamptz
  lastSeenAt  DateTime     @default(now()) @db.Timestamptz
  revokedAt   DateTime?    @db.Timestamptz
  admin       AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model Persona {
  id                 String               @id @default(uuid()) @db.Uuid
  slug               String               @unique @db.VarChar(80)
  name               String               @db.VarChar(80)
  summary            String               @default("")
  background         String               @default("")
  avatarUrl          String?
  status             String               @default("draft")
  revision           Int                  @default(0)
  tags               String[]             @default([])
  isTest             Boolean              @default(false)
  draftVersionId     String?              @db.Uuid
  publishedSlug      String?              @unique @db.VarChar(80)
  publishedVersionId String?              @db.Uuid
  createdAt          DateTime             @default(now()) @db.Timestamptz
  updatedAt          DateTime             @updatedAt @db.Timestamptz
  versions           PersonaCoreVersion[] @relation("PersonaVersions")
  draftVersion       PersonaCoreVersion?  @relation("DraftVersion", fields: [id, draftVersionId], references: [personaId, id], onDelete: Restrict, onUpdate: NoAction, map: "persona_draft_version_owner")
  publishedVersion   PersonaCoreVersion?  @relation("PublishedVersion", fields: [id, publishedVersionId], references: [personaId, id], onDelete: Restrict, onUpdate: NoAction, map: "persona_published_version_owner")
  categories         PersonaCategory[]
  chats              ChatSession[]

  @@index([status, updatedAt, id])
}

model PersonaCoreVersion {
  id              String               @id @default(uuid()) @db.Uuid
  personaId       String               @db.Uuid
  versionNumber   Int
  coreText        String
  openingMessage  String
  profileSnapshot Json
  createdBy       String               @db.Uuid
  restoredFromId  String?              @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz
  persona         Persona              @relation("PersonaVersions", fields: [personaId], references: [id], onDelete: Restrict)
  draftFor        Persona[]            @relation("DraftVersion")
  publishedFor    Persona[]            @relation("PublishedVersion")
  restoredFrom    PersonaCoreVersion?  @relation("RestoredVersion", fields: [personaId, restoredFromId], references: [personaId, id], onDelete: Restrict, onUpdate: NoAction, map: "restored_version_owner")
  restorations    PersonaCoreVersion[] @relation("RestoredVersion")
  author          AdminAccount         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  chats           ChatSession[]

  @@unique([personaId, versionNumber])
  @@unique([personaId, id])
}

model Category {
  id        String            @id @default(uuid()) @db.Uuid
  slug      String            @unique @db.VarChar(80)
  name      String            @unique @db.VarChar(80)
  sortOrder Int               @default(0)
  personas  PersonaCategory[]
}

model PersonaCategory {
  personaId  String   @db.Uuid
  categoryId String   @db.Uuid
  persona    Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([personaId, categoryId])
  @@index([categoryId, personaId])
}

model VisitorSession {
  id        String        @id @default(uuid()) @db.Uuid
  tokenHash String        @unique @db.Char(64)
  createdAt DateTime      @default(now()) @db.Timestamptz
  expiresAt DateTime      @db.Timestamptz
  revokedAt DateTime?     @db.Timestamptz
  chats     ChatSession[]

  @@index([expiresAt])
}

model ChatSession {
  id            String             @id @default(uuid()) @db.Uuid
  personaId     String             @db.Uuid
  coreVersionId String             @db.Uuid
  adminId       String?            @db.Uuid
  visitorId     String?            @db.Uuid
  status        String             @default("active")
  createdAt     DateTime           @default(now()) @db.Timestamptz
  updatedAt     DateTime           @updatedAt @db.Timestamptz
  persona       Persona            @relation(fields: [personaId], references: [id], onDelete: Restrict)
  coreVersion   PersonaCoreVersion @relation(fields: [personaId, coreVersionId], references: [personaId, id], onDelete: Restrict)
  admin         AdminAccount?      @relation(fields: [adminId], references: [id], onDelete: Restrict)
  visitor       VisitorSession?    @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  messages      ChatMessage[]
  usage         AiUsageRecord[]
  requests      ChatRequest[]

  @@unique([id, coreVersionId])
  @@index([adminId, updatedAt])
  @@index([visitorId, updatedAt])
}

model ChatMessage {
  id              String      @id @default(uuid()) @db.Uuid
  sessionId       String      @db.Uuid
  sequence        Int
  role            String
  content         String
  clientMessageId String      @db.Uuid
  status          String      @default("complete")
  createdAt       DateTime    @default(now()) @db.Timestamptz
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@unique([sessionId, clientMessageId, role])
}

model ChatRequest {
  id                   String          @id @default(uuid()) @db.Uuid
  sessionId            String          @db.Uuid
  clientMessageId      String          @db.Uuid
  fingerprint          String          @db.Char(64)
  status               String
  coreVersionId        String          @db.Uuid
  inputText            String
  contextSequence      Int             @default(0)
  maxOutputTokens      Int
  estimatedInputTokens Int
  fencingToken         BigInt          @default(0)
  updatedAt            DateTime        @default(now()) @db.Timestamptz
  errorCode            String?
  leaseExpiresAt       DateTime?       @db.Timestamptz
  response             Json?
  createdAt            DateTime        @default(now()) @db.Timestamptz
  session              ChatSession     @relation(fields: [sessionId, coreVersionId], references: [id, coreVersionId], onDelete: Restrict, onUpdate: NoAction, map: "ChatRequest_sessionId_fkey")
  reservation          AiReservation?
  ledger               AiLedgerEntry[]
  usage                AiUsageRecord?

  @@unique([sessionId, id])
  @@unique([sessionId, clientMessageId])
}

model AiUsageRecord {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @unique @db.Uuid
  sessionId    String      @db.Uuid
  provider     String
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  reservedCost Decimal     @db.Decimal(18, 8)
  actualCost   Decimal?    @db.Decimal(18, 8)
  currency     String      @default("CNY") @db.Char(3)
  status       String
  createdAt    DateTime    @default(now()) @db.Timestamptz
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  request      ChatRequest @relation(fields: [sessionId, requestId], references: [sessionId, id], onDelete: Restrict, onUpdate: NoAction, map: "usage_request")

  @@unique([sessionId, requestId])
  @@index([createdAt, status])
}

model QuotaBucket {
  scope        String
  subject      String
  bucketStart  DateTime @db.Timestamptz
  calls        Int      @default(0)
  reservedCost Decimal  @default(0) @db.Decimal(18, 8)

  @@id([scope, subject, bucketStart])
}

model AdminAuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  adminId       String       @db.Uuid
  action        String
  objectType    String
  objectId      String?
  requestId     String
  changeSummary Json
  createdAt     DateTime     @default(now()) @db.Timestamptz
  admin         AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([objectType, objectId, createdAt])
}

model LoginAttempt {
  key         String   @id @db.Char(64)
  windowStart DateTime @db.Timestamptz
  count       Int      @default(0)
}

model AiControl {
  id              String  @id @default("global")
  privacySalt     String  @default(dbgenerated("((gen_random_uuid())::text || (gen_random_uuid())::text)"))
  fakeEnabled     Boolean @default(false)
  circuitOpen     Boolean @default(false)
  reason          String  @default("")
  priceVersion    String  @default("")
  maxRequestUnits BigInt  @default(0)
  maxInputTokens  Int     @default(0)
  maxOutputTokens Int     @default(0)
  maxRunning      Int     @default(0)
  ratePerMinute   Int     @default(0)
  requestsPerDay  Int     @default(0)
}

model AiPrice {
  version      String          @id
  currency     String          @db.Char(3)
  inputUnits   BigInt
  outputUnits  BigInt
  simulated    Boolean         @default(true)
  reservations AiReservation[]
}

model AiBudget {
  id            String   @id @default(uuid()) @db.Uuid
  scope         String
  subject       String
  period        String
  currency      String   @db.Char(3)
  limitUnits    BigInt   @default(0)
  reservedUnits BigInt   @default(0)
  spentUnits    BigInt   @default(0)
  holds         AiHold[]

  @@unique([scope, subject, period, currency])
}

model AiReservation {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @unique @db.Uuid
  request      ChatRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  priceVersion String
  price        AiPrice     @relation(fields: [priceVersion], references: [version], onDelete: Restrict)
  amountUnits  BigInt
  status       String      @default("held")
  createdAt    DateTime    @default(now()) @db.Timestamptz
  holds        AiHold[]
}

model AiHold {
  reservationId String        @db.Uuid
  budgetId      String        @db.Uuid
  reservation   AiReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  budget        AiBudget      @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  @@id([reservationId, budgetId])
}

model AiLedgerEntry {
  id        String      @id @default(uuid()) @db.Uuid
  requestId String      @db.Uuid
  request   ChatRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kind      String
  units     BigInt
  currency  String      @db.Char(3)
  evidence  String      @unique
  simulated Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([requestId, createdAt])
}

model AiRateBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @db.Timestamptz
}

model AiSafetyEvent {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String?
  code      String
  createdAt DateTime @default(now()) @db.Timestamptz
}
