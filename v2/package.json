{
  "name": "personaverse-v2",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @pv/api build && pnpm --filter @pv/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @pv/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate --schema database/schema.prisma",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "contracts:generate": "node --import tsx scripts/generate-openapi.ts",
    "format:check": "prettier --check .",
    "test:database": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "test:database:e2e": "node --env-file=.env.test.local --import tsx scripts/database-browser.ts",
    "db:test:start": "node scripts/test-postgres.mjs start",
    "db:test:stop": "node scripts/test-postgres.mjs stop",
    "db:migrate:local": "node --env-file=.env.local scripts/database.mjs migrate",
    "admin:init": "node --env-file=.env.local --import tsx scripts/init-admin.ts",
    "cf:client": "node scripts/generate-worker-client.mjs",
    "cf:build": "node scripts/cf-local.mjs build",
    "cf:dev": "node scripts/cf-local.mjs dev",
    "cf:verify": "node scripts/validate-worker-local.mjs",
    "cf:typecheck": "tsc --noEmit -p cloudflare/tsconfig.json",
    "ai:recover:test": "node --env-file=.env.test.local --import tsx scripts/ai-recover.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "prisma": "6.19.3",
    "@pv/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "prettier": "3.6.2",
    "@node-rs/argon2": "2.2.2",
    "wrangler": "4.161.0",
    "@opennextjs/cloudflare": "1.20.17",
    "@prisma/adapter-pg": "6.19.3",
    "pg": "8.23.1",
    "@types/pg": "8.15.6",
    "hash-wasm": "4.13.0"
  },
  "type": "module"
}
